#include "Version.xcconfig"

SWIFT_VERSION = 6.0

// Minimum deployment target for the app and every extension target. Centralized
// here (the four project configs all include this file) so there is a single iOS
// floor; the per-target IPHONEOS_DEPLOYMENT_TARGET overrides in project.pbxproj
// were removed when the floor moved to iOS 26. Keep in sync with the .iOS(...)
// platform in Modules/Package.swift.
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// Strict-concurrency ratchet: warnings outside Modules/Sources are gated against
// scripts/ci/concurrency-baseline.txt (deletion-only) by scripts/ci/check-concurrency-warnings.sh.
// See MODERNIZATION.md. Regenerate the baseline with `mise run concurrency:baseline`.
// Phase 4: `complete` checks all code, not just code that already adopts concurrency; the
// baseline captured the full warning set on flip day and only ever shrinks from here.
SWIFT_STRICT_CONCURRENCY = complete

// Infer `Sendable` for closures and key paths whose captures are all `Sendable`
// (SE-0418). Matches the `InferSendableFromCaptures` upcoming feature the SPM modules
// already enable, and lets key-path literals like `\.fileLog` be `Sendable` so the
// swift-dependencies `@Dependency` property wrapper is usable in `@MainActor` types.
SWIFT_UPCOMING_FEATURE_INFER_SENDABLE_FROM_CAPTURES = YES

// Map our custom version values (used by the automation tooling) to the values
// Xcode uses
MARKETING_VERSION = $(VERSION_SHORT)
CURRENT_PROJECT_VERSION = $(VERSION_LONG)

// Define a root bundle identifier so that extensions can append to it
PRODUCT_BUNDLE_IDENTIFIER_ROOT = au.com.shiftyjelly.podcasts

// App Group shared by the app and its extensions. Entitlements files and the
// runtime constant (SharedConstants.GroupUserDefaults.groupContainerId, via the
// PCAppGroupIdentifier Info.plist key) both resolve this build setting, so a
// fork can rebrand the group with a single override (see docs/testflight.md).
APP_GROUP_IDENTIFIER = group.au.com.shiftyjelly.pocketcasts

DEVELOPMENT_TEAM = PZYM8XX95Q // Automattic, Inc. (Company)

// Coordinated fork backend. Xcconfig treats // as a comment, so the empty
// expansion keeps the URL separator intact. Override these two values in a
// private/release overlay when the canonical DNS name changes.
PODCAST_BACKEND_HOST = podcasts.hbmartin.com
PODCAST_BACKEND_ORIGIN = https:/$()/$(PODCAST_BACKEND_HOST)
