# You don't need to fill in these values for Fastlane to run.
#
# However, if a lane requires some of these environment values and they are not set here, it will fail.
GITHUB_TOKEN=
SLACK_WEBHOOK=
BITDRIFT_API_KEY=
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY=

# Only needed by the `personal_testflight` lane (docs/testflight.md),
# which ships the fork under your own Apple Developer team.
PERSONAL_APPLE_TEAM_ID=
PERSONAL_BUNDLE_ID_ROOT=
PERSONAL_APP_GROUP_ID=
# Optional VERSION_LONG override for a single personal build.
PERSONAL_BUILD_NUMBER=
